# Environment variables
.env
.env.local
.env.*.local

# Python virtual environment & interpreter copies
.venv/
.local_python/
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Testing & caches
.pytest_cache/
.coverage
htmlcov/
.uv_cache/
.uv_python/

# Database & local state
*.db
*.sqlite3

# Storage & media cache (downloaded youtube videos, audio, intermediate cuts, output)
storage/cache/*
storage/transcripts/*
storage/temp/*
storage/output/*
!storage/cache/.gitkeep
!storage/transcripts/.gitkeep
!storage/temp/.gitkeep
!storage/output/.gitkeep

# Node.js & Frontend dependencies
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS specific files
.DS_Store
Thumbs.db
desktop.ini
